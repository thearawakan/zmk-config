#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC         &kp N1  &kp NUMBER_2  &kp N3         &kp N4        &kp N5                                            &kp N6  &kp N7  &kp N8         &kp N9   &kp N0     &kp QUESTION
&kp TAB         &kp Q   &kp W         &kp E          &kp R         &kp T                                             &kp Z   &kp U   &kp I          &kp O    &kp P      &kp GRAVE
&mo 3           &kp A   &kp S         &kp D          &kp F         &kp G                                             &kp H   &kp J   &kp K          &kp L    &kp SEMI   &kp SINGLE_QUOTE
&kp LEFT_SHIFT  &kp Y   &kp X         &kp C          &kp V         &kp B      &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N   &kp M   &kp COMMA      &kp DOT  &kp MINUS  &kp RIGHT_SHIFT
                                      &kp LEFT_META  &kp LEFT_ALT  &kp LCTRL  &kp SPACE           &kp RET            &mo 2   &mo 1   &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F1            &kp F2    &kp F3  &kp F4    &kp F5      &kp F6                                        &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12
&kp F1            &kp F2    &kp F3  &kp F4    &kp F5      &kp F6                                        &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12
&kp LEFT_SHIFT    &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp TILDE
&kp LEFT_CONTROL  &trans    &trans  &trans    &trans      &trans     &kp LESS_THAN    &kp GREATER_THAN  &trans     &kp MINUS  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                                    &trans    &trans      &trans     &trans           &trans            &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp ASTERISK      &kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp DOLLAR  &kp PERCENT                                     &kp AMPERSAND    &kp SLASH  &kp BACKSLASH  &kp PIPE   &kp EQUAL       &kp BACKSPACE
&kp CARET         &kp N1           &kp N2             &kp N3            &kp N4      &kp N5                                          &kp N6           &kp N7     &kp N8         &kp N9     &kp PLUS        &kp TILDE
&kp LEFT_SHIFT    &kp F2           &kp F3             &kp F4            &kp F5      &kp F6                                          &kp LEFT         &kp DOWN   &kp UP         &kp RIGHT  &kp MINUS       &kp PIPE
&kp LEFT_CONTROL  &kp F8           &kp F9             &kp F10           &kp F11     &kp F12      &kp LESS_THAN    &kp GREATER_THAN  &kp EXCLAMATION  &kp EQUAL  &kp PLUS       &kp MINUS  &kp UNDERSCORE  &trans
                                                      &trans            &trans      &trans       &trans           &trans            &trans           &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        config {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans                             &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP
&trans      &trans        &trans        &trans        &trans  &trans                             &trans  &trans  &trans  &trans  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN
&trans      &trans        &trans        &trans        &trans  &trans                             &trans  &trans  &trans  &trans  &trans                &kp C_MUTE
&trans      &trans        &trans        &trans        &trans  &trans  &kp C_PAUSE    &kp C_PLAY  &trans  &trans  &trans  &trans  &trans                &trans
                                        &trans        &trans  &trans  &trans         &trans      &trans  &trans  &trans
            >;
        };
    };
};
